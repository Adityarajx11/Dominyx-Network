{
  "name": "dominyx-network",
  "version": "0.1.0",
  "private": true,
  "description": "Dominyx — a family of single-purpose Discord bots",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:music": "npm -w dominyx-music start",
    "deploy:music": "npm -w dominyx-music run deploy",
    "start:level": "npm -w dominyx-level start",
    "deploy:level": "npm -w dominyx-level run deploy",
    "start:greet": "npm -w dominyx-greet start",
    "deploy:greet": "npm -w dominyx-greet run deploy",
    "install:all": "npm install"
  }
}
