# Where the site lives (used for login links shown to users) — optional
PUBLIC_APP_URL=http://localhost:3000

# Application (Client) IDs for each bot — used to build "Add to Discord" invite links
BOT_ID_MUSIC=
BOT_ID_LEVEL=
BOT_ID_GREET=
BOT_ID_TICKET=
BOT_ID_PING=
BOT_ID_GUARD=